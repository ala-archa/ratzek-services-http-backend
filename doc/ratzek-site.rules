# Canonical copy of the host-direct Prometheus rules deployed to
# /etc/prometheus/rules/ratzek-site.rules (ansible is outdated; managed by hand).
# Thresholds calibrated against 7-day Prometheus history. See doc/alerting-runbook.md.
groups:
  - name: ratzek-site
    rules:
      # Battery / BMS alerts (RatzekBatteryDeepDischarge, RatzekBatteryVoltageLow, RatzekBMSAlarm,
      # RatzekBMSCommsLost, RatzekBMSCellImbalance, ...) MOVED 2026-08-12 to the daly-bms-exporter
      # repo: doc/ratzek-bms.rules there is canonical, deployed to /etc/prometheus/rules/ratzek-bms.rules.
      # RatzekBatterySOCLow/SOCCritical and RatzekBMSChargingCold were dropped on purpose (BMS SOC is
      # unreliable; the pack is LTO, not LFP — cold charging is fine). Do not re-add them here:
      # the same alert name in two files pages twice. (RatzekSolarNotChargingDaytime was removed
      # even earlier, 2026-07-12: no reliable threshold on this host.)

      - alert: RatzekPoEPortDown
        # group_left(comment): poe_current не несёт подпись порта — подтягиваем её из _running
        # (max without(...) схлопывает волатильный running и лишние лейблы, оставляя comment).
        expr: (mikrotik_poe_current == 0) * on(name, interface) group_left(comment) (max without(running, disabled, slave, type, address, instance, job) (mikrotik_interface_running))
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "PoE-порт без питания: {{ $labels.name }} {{ $labels.interface }} «{{ $labels.comment }}»"

      - alert: RatzekMikrotikUnreachable
        expr: mikrotik_scrape_collector_success == 0
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "MikroTik недоступен для опроса: {{ $labels.name }}"

      - alert: RatzekWANDown
        expr: ratzek_internet_available == 0
        for: 10m
        labels: { severity: critical }
        annotations:
          summary: "Нет интернета (WAN down) — аплинк недоступен"

      - alert: RatzekAlertingDegraded
        expr: rate(alertmanager_notifications_failed_total[10m]) > 0 or rate(ratzek_alert_webhook_errors_total[15m]) > 0 or ratzek_telegram_queue_len > 20
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Деградация доставки алертов (очередь/ошибки webhook/AM notif-fail)"

      # --- Tier 2 (added 2026-07-10) ---
      - alert: RatzekLTEFlapping
        expr: resets(mikrotik_lte_interface_session_uptime[1h]) > 3
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "LTE часто переподключается: {{ $value | humanize }} реконнектов/час ({{ $labels.name }})"

      - alert: RatzekDeviceMetricsStalled
        expr: ratzek_device_metrics_age_seconds > 1800
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Сэмплер device-metrics завис: {{ $value | humanize }}с без обновления"

      - alert: RatzekPiTempHigh
        expr: node_hwmon_temp_celsius > 75
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Температура Pi {{ $value | humanize }}°C — близко к троттлингу"

      - alert: RatzekACLMassDrop
        expr: delta(ratzek_clients_in_acl[15m]) < -30
        for: 1m
        labels: { severity: warning }
        annotations:
          summary: "Резкий обвал клиентов в acl: {{ $value | humanize }} за 15м (массовый дисконнект?)"

      - alert: RatzekMikrotikLinkFlapping
        # только ether: WiFi (wlan*) флапает по природе (до 17/ч) — не про «линк»; ethernet <~1/ч.
        # max without(running,...): у порта 2 серии по волатильному running — схлопываем, сохраняя comment.
        expr: max without(running, disabled, slave, type) (increase(mikrotik_interface_link_downs{interface=~"ether.*"}[1h])) > 5
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Флап линка MikroTik: {{ $value | humanize }} падений/час ({{ $labels.name }} {{ $labels.interface }} «{{ $labels.comment }}»)"

      - alert: RatzekISPBalanceCritical
        expr: ratzek_isp_balance < 200
        for: 15m
        labels: { severity: critical }
        annotations:
          summary: "Баланс SIM критический: {{ $value | humanize }} — скоро отключат"

      # --- Tier 3 (added 2026-07-10) ---
      # RatzekWebcamStale requires the textfile metric ratzek_webcam_last_image_timestamp,
      # produced by doc/webcam-freshness-metric.sh (cron */5, node_exporter textfile collector).
      - alert: RatzekWebcamStale
        expr: time() - ratzek_webcam_last_image_timestamp > 1200
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "Камера не обновляет снимок уже {{ $value | humanize }}с (зависла / нет непустых кадров)"

      # RatzekDiskCanaryDead requires the textfile metric ratzek_disk_canary_timestamp_seconds,
      # produced by doc/disk-canary.py (disk-canary.service, every 10 s). A wedged SSD does not
      # page here — it hard-reboots the host (FailureAction=reboot-immediate). This alert catches the
      # canary itself being dead (crash-restart loop, disabled, metric dir gone), i.e. the host
      # running unprotected. Grouped with the boot gap: 5 min stale + 10 min for = no boot-time noise.
      - alert: RatzekDiskCanaryDead
        expr: time() - ratzek_disk_canary_timestamp_seconds > 300 or absent(ratzek_disk_canary_timestamp_seconds)
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "disk-canary не пишет heartbeat (сервис мёртв?) — хост без защиты от зависания SSD"

      - alert: RatzekMikrotikHighCPU
        expr: mikrotik_system_cpu_load > 90
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "MikroTik CPU {{ $value | humanize }}% ({{ $labels.name }})"

      - alert: RatzekMikrotikLowMemory
        expr: mikrotik_system_free_memory / mikrotik_system_total_memory < 0.08
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "MikroTik мало памяти: {{ $value | humanizePercentage }} свободно ({{ $labels.name }})"

      # --- Infra ICMP loss/RTT (added 2026-07-19) ---
      # Textfile metrics from doc/infra-ping-metric.sh (cron */1, node_exporter textfile
      # collector). Loss to the LTE dish is noisy by nature → separate relaxed rule below.
      # A device fully down shows loss=1 → PacketLoss fires (no separate up==0 alert; full
      # MikroTik outages are already caught by RatzekMikrotikUnreachable). Thresholds are
      # provisional — tune against a few days of baseline.
      - alert: RatzekInfraPacketLoss
        expr: ratzek_infra_ping_loss_ratio{device!="zvonilka-Mikrotik-LHG"} > 0.2
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Потери пакетов к {{ $labels.device }} ({{ $labels.ip }}): {{ $value | humanizePercentage }}"

      - alert: RatzekInfraPacketLossUplink
        expr: ratzek_infra_ping_loss_ratio{device="zvonilka-Mikrotik-LHG"} > 0.5
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "Высокие потери на LTE-аплинке {{ $labels.ip }}: {{ $value | humanizePercentage }}"

      - alert: RatzekInfraPingStale
        expr: time() - ratzek_infra_ping_last_check_timestamp > 300
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Инфра-пинг-метрики не обновляются {{ $value | humanize }}с (скрипт завис/упал)"

      # RTT-деградация линка без потерь пакетов. Baseline всех 7 узлов ~0.3–1 мс (локальные
      # хопы) → 50 мс = явная деградация. Порог провизорный, откалибровать по baseline.
      - alert: RatzekInfraLatencyHigh
        expr: ratzek_infra_ping_rtt_ms > 50
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Высокий RTT к {{ $labels.device }} ({{ $labels.ip }}): {{ $value | humanize }}мс"

      # --- Shaper byte-quota reset job (added 2026-07-28) ---
      # Per-client shaper quota reset (src/shaper_quota.rs) runs every ~60s and exposes
      # ratzek_shaper_quota_age_seconds. A silently-stalled job means clients that
      # crossed the 1 GiB --bytes-gt throttle stay rate-limited forever (the exact
      # incident this feature fixes), so alert if the pass goes stale. Only fires when
      # the job is enabled and has run at least once (age gauge absent otherwise).
      - alert: RatzekShaperQuotaStalled
        expr: ratzek_shaper_quota_age_seconds > 600
        for: 5m
        labels: { severity: warning }
        annotations:
          summary: "Джоб сброса квоты shaper завис: {{ $value | humanize }}с без прохода (клиенты висят throttled)"

      # MAC-change (inheritance) resets: genuine IP hand-overs are rare (a few/hour over
      # ≤206 IPs). A sustained spike more likely means a corrupt/half-read dnsmasq leases
      # file → mass false-reset (everyone un-throttled) than real churn. Threshold is
      # provisional (baseline ~0, calibrate). Resets are un-throttle direction → warning.
      - alert: RatzekShaperQuotaMacResetSpike
        expr: rate(ratzek_shaper_quota_mac_change_resets_total[10m]) > 0.05
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Всплеск mac-change сбросов shaper: {{ $value | humanize }}/с (битые lease-файлы? churn?)"

      # None-learn inheritance resets (0.1.39): reset on adopting an owner for an IP whose
      # counter is already > quota/4 (previous owner never known). Baseline ~0. A sustained
      # spike means either a real inheritance storm or a mass false-reset after a bare
      # restart with correlated owner-file + leases IO failure. Separate counter from
      # mac-change, so it needs its own spike alert. Un-throttle direction → warning.
      - alert: RatzekShaperQuotaInheritanceResetSpike
        expr: rate(ratzek_shaper_quota_inheritance_resets_total[10m]) > 0.05
        for: 10m
        labels: { severity: warning }
        annotations:
          summary: "Всплеск inheritance-сбросов shaper: {{ $value | humanize }}/с (масс-наследование? двойной IO-отказ после рестарта?)"

      # The opposite failure: a chronically unreadable leases file silently disables the
      # MAC-change trigger (mac resets fall to ~0 → invisible to the spike alert above).
      - alert: RatzekShaperQuotaLeasesUnreadable
        expr: rate(ratzek_shaper_quota_leases_read_failures_total[10m]) > 0
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "shaper-quota не может прочитать dnsmasq leases {{ $value | humanize }}/с — mac-детект отключён"

      # --- Owner-MAC persistence (durable inheritance fix, added 2026-08-02) ---
      # A SEPARATE job persists the per-IP owning-MAC to disk (owner_state_path) every
      # ~2min so the MAC-change/inheritance reset survives process restarts. If that write
      # keeps failing, durability silently degrades to the in-memory backstop → the very
      # inheritance bug this fixes creeps back after the next restart. Fires only when
      # persistence is enabled (fail-fast errors return and increment this counter).
      - alert: RatzekShaperQuotaOwnerPersistFailing
        expr: rate(ratzek_shaper_quota_owner_persist_failures_total[10m]) > 0
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "shaper-quota не может записать owner-MAC файл {{ $value | humanize }}/с — durability деградирует"

      # The other failure mode: a wedged fsync on the flaky USB-SSD never RETURNS an error
      # (D-state), so the counter above stays flat. The persist job stamps a liveness age
      # on every HEALTHY pass (write OR no-op), so a growing age = a hung writer. The gauge
      # is absent when persistence is disabled / never ran → no false page.
      - alert: RatzekShaperQuotaOwnerPersistStalled
        expr: ratzek_shaper_quota_owner_persist_age_seconds > 600
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "shaper-quota owner-persist завис: {{ $value | humanize }}с без здорового прохода (SSD wedge?)"

      # --- Tier 3 (added 2026-08-04, public webcam frame on the forecast page) ---
      # Deployed by hand on 2026-08-04; copied back into this canonical file on 2026-09-16.
      # The archive can keep growing while the copy the web page reads is stuck
      # (missing directory, permissions, a failure between the archive write and
      # the hardlink). RatzekWebcamStale above would stay green through that,
      # and the public page would show a frozen frame indefinitely.
      # Metrics come from webcam-freshness-metric.sh (same cron */5).
      - alert: RatzekWebcamLatestStale
        expr: time() - ratzek_webcam_latest_mtime_seconds > 1200 or ratzek_webcam_latest_json_ok == 0
        for: 15m
        labels: { severity: warning }
        annotations:
          summary: "Публикуемый кадр не обновляется: страница прогноза показывает застывшую картинку"
